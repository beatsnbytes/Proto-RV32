// Stress multiplier and forwarding paths
//00300093   # ADDI x1, x0, 3      x1 = 3
//00500113   # ADDI x2, x0, 5      x2 = 5
//022081B3   # MUL  x3, x1, x2     x3 = 15
//00312023   # SW   x3, 0(x2)      mem[5] = 15
//00012203   # LW   x4, 0(x2)      x4 = 15
//024182B3   # MUL  x5, x3, x4     x5 = 225
//02428333   # MUL  x6, x5, x4     x6 = 3375
//005303B3   # ADD  x7, x6, x5     x7 = 3600


// Exercise eviction
//02000093   # ADDI x1, x0, 0x20     x1 = A   (index 2, tag 0)
//42000113   # ADDI x2, x0, 0x420    x2 = B   (index 2, tag 1) — collides with A
//0AA00193   # ADDI x3, x0, 0xAA     x3 = 0xAA (value for A)
//0BB00213   # ADDI x4, x0, 0xBB     x4 = 0xBB (value for B)
//0030A023   # SW   x3, 0(x1)        mem/cache[A] = 0xAA  → block A dirty in set 2
//00412023   # SW   x4, 0(x2)        store B → same set, evicts dirty A (write-back!)
//0000A283   # LW   x5, 0(x1)        load A → miss, refetch from main mem → x5 = 0xAA
//00128313   # ADDI x6, x5, 1        x6 = 0xAB  (visible success marker)


// Branch-flush probe
//00700093   # ADDI x1, x0, 7      x1 = 7
//00700113   # ADDI x2, x0, 7      x2 = 7   (x1==x2 → BEQ taken)
//00000513   # ADDI x10,x0, 0      x10 = 0  (canary marker, stays 0 if flush works)
//00208863   # BEQ  x1, x2, +16    taken → target 0x1C
//06F00513   # ADDI x10,x0, 111    SHADOW canary 1 — must NOT execute
//0DE00513   # ADDI x10,x0, 222    SHADOW canary 2 — must NOT execute
//14D00513   # ADDI x10,x0, 333    (skipped by target too)
//3E700593   # ADDI x11,x0, 999    TARGET — should execute → x11 = 999

// TEST A — BNE taken (the func3=001 path, which your BEQ test didn't exercise):
// PASS: x10=0, x11=999. Confirms the !zero branch condition works, not just BEQ.
//00500093  # ADDI x1,x0,5
//00900113  # ADDI x2,x0,9
//00000513  # ADDI x10,x0,0
//00209863  # BNE x1,x2,+16   → taken (5≠9), target 0x1C
//06F00513  # ADDI x10,x0,111  ← shadow, must die
//0DE00513  # ADDI x10,x0,222  ← shadow, must die
//14D00513  # ADDI x10,x0,333
//3E700593  # ADDI x11,x0,999  ← target

// TEST B — Not-taken (confirms you don't over-flush):
// PASS: x10=111, x11=222, x12=333. If any is 0, you're flushing on not-taken (over-flush bug).
//00500093  # ADDI x1,x0,5
//00900113  # ADDI x2,x0,9
//00208863  # BEQ x1,x2,+16   → NOT taken (5≠9)
//06F00513  # ADDI x10,x0,111  ← MUST execute
//0DE00593  # ADDI x11,x0,222  ← MUST execute
//14D00613  # ADDI x12,x0,333  ← MUST execute

// TEST C — Data-dependent branch, loose (producer 3 before branch):
// PASS: x11=999, x10=0.
//00500093  # ADDI x1,x0,5
//00500113  # ADDI x2,x0,5
//002081B3  # ADD  x3,x1,x2    → x3=10
//00000513  # ADDI x10,x0,0
//00A00213  # ADDI x4,x0,10
//00418663  # BEQ x3,x4,+12    → taken if x3==10, target 0x20
