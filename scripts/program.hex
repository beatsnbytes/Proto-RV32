//0DE00513  # ADDI x10,x0,222
//3E700593  # ADDI x11,x0,999  ← target

// TEST D — Data-dependent branch, TIGHT (producer immediately before branch — the real forwarding stress):
//00400093  # ADDI x1,x0,4
//00400113  # ADDI x2,x0,4
//00000513  # ADDI x10,x0,0
//002082B3  # ADD  x5,x1,x2    → x5=8, RIGHT before branch
//00128663  # BEQ x5,x1,+12    → 8≠4, NOT taken
//06F00513  # ADDI x10,x0,111  ← should run
//0DE00593  # ADDI x11,x0,222  ← should run
//14D00613  # ADDI x12,x0,333

// TEST E — Backward branch / loop (3-iteration countdown):
//00300093  # ADDI x1,x0,3     counter
